{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "spawn/domain-search",
	"version": "0.1.0",
	"title": "Domain Search",
	"category": "widgets",
	"icon": "search",
	"description": "Search for available domain names",
	"keywords": [ "domain", "search", "spawn" ],
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"textdomain": "spawn",
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"attributes": {
		"placeholder": {
			"type": "string",
			"default": "Enter a domain name..."
		},
		"showSuggestions": {
			"type": "boolean",
			"default": true
		}
	}
}
