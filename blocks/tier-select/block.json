{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "spawn/tier-select",
	"version": "0.1.0",
	"title": "Tier Selection",
	"category": "widgets",
	"icon": "products",
	"description": "Display pricing tiers for AI website service",
	"keywords": [ "pricing", "tiers", "spawn" ],
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"textdomain": "spawn",
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"attributes": {
		"highlightedTier": {
			"type": "string",
			"default": "pro"
		},
		"showFeatures": {
			"type": "boolean",
			"default": true
		}
	}
}
