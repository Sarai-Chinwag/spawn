# =============================================================================
# Spawn Tenant Configuration
# Copy to .env and fill in values for each tenant
# =============================================================================

# Database
WP_DB_NAME=wordpress
WP_DB_USER=wp_user
WP_DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root

# Resource limits
WP_CPU_LIMIT=1.0
WP_MEM_LIMIT=512M
DB_CPU_LIMIT=0.5
DB_MEM_LIMIT=256M

# Tenant port (host nginx proxies subdomain to this port)
TENANT_PORT=8080

# Agent runtime (leave empty until runtime is chosen)
SPAWN_AGENT_RUNTIME=
SPAWN_AGENT_ENABLED=false
